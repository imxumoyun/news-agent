# Bu faylni .env ga nusxalab, qiymatlarni o'zingiz to'ldiring.
# .env hech qachon git ga tushmaydi (.gitignore da).

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# BotFather bergan token
TELEGRAM_BOT_TOKEN=

# @kanalnomi yoki -1001234567890 ko'rinishidagi raqam
TELEGRAM_CHANNEL_ID=

# --- Instagram (ixtiyoriy, faqat Instagram publisher uchun) ---
# Meta panelidan: Use cases > Customize > API setup with Instagram login
# > Generate access tokens. 60 kun amal qiladi.
INSTAGRAM_ACCESS_TOKEN=
# Quyidagi buyruq bilan olinadi:
#   curl -s "https://graph.instagram.com/me?fields=user_id,username&access_token=TOKEN"
INSTAGRAM_USER_ID=

# Ixtiyoriy. Standart holatda uchala agent ham flash-lite'da ishlaydi —
# bepul tarif chegarasiga sig'ish uchun. Billing yoqsangiz quyidagi ikki
# qatorni oching, matn sifati sezilarli yaxshilanadi:
# ANALYST_MODEL=gemini-3.6-flash
# EDITOR_MODEL=gemini-3.6-flash
# RPM_LIMIT=60
